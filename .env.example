# Front-end (vão para o navegador — só valores PÚBLICOS aqui)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key

# As chaves do Asaas NÃO ficam aqui. Elas vão como secrets das Edge Functions:
#   supabase secrets set ASAAS_API_KEY=... ASAAS_BASE_URL=... ASAAS_WEBHOOK_TOKEN=...
#   (opcional, para dividir 50/50) supabase secrets set ASAAS_SPLIT_WALLET_ID=... ASAAS_SPLIT_PERCENTUAL=50
